<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.krane.aws-sso-refresh</string>

    <!-- Silent refresh (no --interactive): keeps access tokens warm via the
         refresh token; notifies instead of opening a browser if a real login
         is needed, so no stale tabs appear while away. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/prajwalrajbasnet/.dotfiles/scripts/aws-sso-refresh.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Run at login/load and every hour after. Access tokens last hours; this
         keeps a fresh one cached all day. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/tmp/aws-sso-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aws-sso-refresh.log</string>
</dict>
</plist>

# Define bindings for spaces based on label to workaround index changes
cmd - 1 : yabai -m space --focus main
cmd - 2 : yabai -m space --focus browser
cmd - 3 : yabai -m space --focus misc
cmd - 4 : yabai -m space --focus comms
cmd - 5 : yabai -m space --focus entertainment
cmd - 6 : yabai -m space --focus others

# move space to displays
cmd - m : exec ~/.dotfiles/scripts/change-space-display

# Vim-like bindings to change window focus
alt + shift - j : yabai -m window --focus south
alt + shift - k : yabai -m window --focus north
alt + shift - h : yabai -m window --focus west
alt + shift - l : yabai -m window --focus east

# Swap windows
cmd + shift - j : yabai -m window --swap south
cmd + shift - k : yabai -m window --swap north
cmd + shift - h : yabai -m window --swap west
cmd + shift - l : yabai -m window --swap east

# fullscreen space
cmd - f : yabai -m window --toggle zoom-fullscreen

# toggle float
alt + shift - f : yabai -m window --toggle float

# layouts
cmd + shift - s : yabai -m space --layout stack
cmd + shift - t : yabai -m space --layout bsp

# distroy space
alt + shift - q : yabai -m space --destroy

# cycle through stack layout
alt + shift - p : yabai -m window --focus stack.next 
alt + shift - n : yabai -m window --focus stack.prev

# Move window to space
cmd + shift - 1 : yabai -m window --space main
cmd + shift - 2 : yabai -m window --space browser
cmd + shift - 3 : yabai -m window --space misc
cmd + shift - 4 : yabai -m window --space comms
cmd + shift - 5 : yabai -m window --space entertainment
cmd + shift - 6 : yabai -m window --space others

# Application open bindings
cmd + shift - return : open -n  -a "Ghostty"
cmd - w : open -n -a "Zen"

# Reload config
alt + shift - r : source ~/.yabairc

